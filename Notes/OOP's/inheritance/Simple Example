class Vehicle 
{

    void start() 
    {
        System.out.println("Vehicle Starts");
    }
}

class Car extends Vehicle 
{
    void drive() 
    {
        System.out.println("Car Drives");
    }
}

public class Main 
{
    public static void main(String[] args) 
    {
        Car c = new Car();
        c.start();
        c.drive();
    }
}
