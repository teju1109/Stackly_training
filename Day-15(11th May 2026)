2. Flight Booking System

import java.util.*;
// Flight Class
class Flight 
{
    int flightId;
    String flightName;
    String source;
    String destination;
    int availableSeats;
    double ticketPrice;

    // Constructor
    public Flight(int flightId,
                  String flightName,
                  String source,
                  String destination,
                  int availableSeats,
                  double ticketPrice) 
    {
        this.flightId = flightId;
        this.flightName = flightName;
        this.source = source;
        this.destination = destination;
        this.availableSeats = availableSeats;
        this.ticketPrice = ticketPrice;
    }
}

// Main Class
public class FlightBookingSystem 
{
    static ArrayList<Flight> flights = new ArrayList<>();
    static Scanner sc = new Scanner(System.in);
    public static void main(String[] args) 
    {
        // Sample Flights
        flights.add(new Flight(1, "Indigo", "Hyderabad", "Delhi", 5, 4500));
        flights.add(new Flight(2, "Air India", "Chennai", "Mumbai", 3, 5500));
        flights.add(new Flight(3, "SpiceJet", "Bangalore", "Goa", 4, 3000));
        int choice;
        do 
        {
            System.out.println("\n===== Flight Booking System =====");
            System.out.println("1. View Flights");
            System.out.println("2. Book Ticket");
            System.out.println("3. Exit");
            System.out.print("Enter Choice: ");
            choice = sc.nextInt();
            switch(choice) 
            {
                case 1:
                    showFlights();
                    break;
                case 2:
                    bookTicket();
                    break;
                case 3:
                    System.out.println("Thank You!");
                    break;
                default:
                    System.out.println("Invalid Choice");
            }
        } while(choice != 3);
    }

    // Show Flights
    static void showFlights() 
    {
        System.out.println("\nAvailable Flights:");
        for(Flight flight : flights) 
        {
            System.out.println( flight.flightId + " - " + flight.flightName + " - " + flight.source + " to "
                + flight.destination + " - Seats: " + flight.availableSeats + " - ₹" + flight.ticketPrice);
        }
    }

    // Book Ticket
    static void bookTicket() 
    {
        System.out.print("Enter Flight ID: ");
        int id = sc.nextInt();
        for(Flight flight : flights) 
        {
            if(flight.flightId == id) 
            {
                if(flight.availableSeats > 0) 
                {
                    flight.availableSeats--;
                    System.out.println("Ticket Booked Successfully!");
                    System.out.println("Ticket Price: ₹" + flight.ticketPrice);
                    return;
                }
                else 
                {
                    System.out.println("No Seats Available");
                    return;
                }
            }
        }
        System.out.println("Flight Not Found");
    }
}

