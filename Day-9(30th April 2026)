import java.util.Scanner;

public class EmployeeManagementSystem {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Input employee count
        System.out.print("Enter number of employees: ");
        int employees = sc.nextInt();

        String[] employeeNames = new String[employees];
        double[] basicSalary = new double[employees];
        double[] bonus = new double[employees];
        double[] finalSalary = new double[employees];
        char[] ratings = new char[employees];

        // Input employee details
        for (int i = 0; i < employees; i++) {

            sc.nextLine(); // clear buffer

            System.out.println("\nEnter details for Employee " + (i + 1));

            System.out.print("Employee Name: ");
            employeeNames[i] = sc.nextLine();

            // Basic Salary Validation
            while (true) {
                System.out.print("Basic Salary: ");
                double salary = sc.nextDouble();

                if (salary >= 0) {
                    basicSalary[i] = salary;
                    break;
                } else {
                    System.out.println("Invalid! Salary cannot be negative.");
                }
            }

            // Bonus Validation
            while (true) {
                System.out.print("Bonus: ");
                double b = sc.nextDouble();

                if (b >= 0) {
                    bonus[i] = b;
                    break;
                } else {
                    System.out.println("Invalid! Bonus cannot be negative.");
                }
            }

            // Final Salary Calculation
            finalSalary[i] = basicSalary[i] + bonus[i];

            // Performance Rating
            if (finalSalary[i] >= 100000)
                ratings[i] = 'A';
            else if (finalSalary[i] >= 70000)
                ratings[i] = 'B';
            else if (finalSalary[i] >= 50000)
                ratings[i] = 'C';
            else
                ratings[i] = 'D';
        }

        // Find Highest Paid Employee
        int highestIndex = 0;

        for (int i = 1; i < employees; i++) {
            if (finalSalary[i] > finalSalary[highestIndex]) {
                highestIndex = i;
            }
        }

        // Final Report
        System.out.println("\n===== EMPLOYEE REPORT =====");

        System.out.println("ID\tName\tBasic\tBonus\tFinal Salary\tRating");

        for (int i = 0; i < employees; i++) {

            System.out.println(
                    (i + 1) + "\t"
                    + employeeNames[i] + "\t"
                    + basicSalary[i] + "\t"
                    + bonus[i] + "\t"
                    + finalSalary[i] + "\t\t"
                    + ratings[i]
            );
        }

        // Display Highest Paid Employee
        System.out.println("\n===== TOP EMPLOYEE =====");

        System.out.println("Employee Name: " + employeeNames[highestIndex]);
        System.out.println("Final Salary: " + finalSalary[highestIndex]);
        System.out.println("Rating: " + ratings[highestIndex]);

        sc.close();
    }
}

