('Express6','Chennai','Erode');
 
create table bookings (
    booking_id int primary key auto_increment,
    train_id int,
    passenger_name varchar(50),
    fare decimal(10,2),
    status varchar(20),
    foreign key (train_id) references trains(train_id)
);
 
