TASK TO CREATE A TABLE.

CREATE DATABASE books;
USE books;

CREATE table books(
books_id INT PRIMARY KEY auto_increment,
books_title varchar(100),
books_author varchar(100),
books_genre varchar(250),
books_price int,
books_publishYear int,
books_inStock boolean
);

