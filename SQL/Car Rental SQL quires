SELECT users.name, bikes.bike_name, bookings.start_date, bookings.end_date, bookings.total_price
FROM bookings
INNER JOIN users ON bookings.user_id = users.user_id
INNER JOIN bikes ON bookings.bike_id = bikes.bike_id;

SELECT users.name, bikes.bike_name, bookings.start_date, bookings.end_date, bookings.total_price
FROM bookings
left JOIN users ON bookings.user_id = users.user_id
left JOIN bikes ON bookings.bike_id = bikes.bike_id;

SELECT users.name, bikes.bike_name
FROM users
LEFT JOIN bookings ON users.user_id = bookings.user_id
LEFT JOIN bikes ON bookings.bike_id = bikes.bike_id;

SELECT bikes.bike_name, users.name
FROM bikes
RIGHT JOIN bookings ON bikes.bike_id = bookings.bike_id
LEFT JOIN users ON bookings.user_id = users.user_id;

