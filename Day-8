1. Employee Management System (Based on Your StudentResultSystem Logic)
import java.util.Scanner;

public class EmployeeManagementSystem {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Input employee count
        System.out.print("Enter number of employees: ");
        int employees = sc.nextInt();

        String[] employeeNames = new String[employees];
        double[] basicSalary = new double[employees];
        double[] bonus = new double[employees];
        double[] finalSalary = new double[employees];
        char[] ratings = new char[employees];

        // Input employee details
        for (int i = 0; i < employees; i++) {

            sc.nextLine(); // clear buffer

            System.out.println("\nEnter details for Employee " + (i + 1));

            System.out.print("Employee Name: ");
            employeeNames[i] = sc.nextLine();

            // Basic Salary Validation
            while (true) {
                System.out.print("Basic Salary: ");
                double salary = sc.nextDouble();

                if (salary >= 0) {
                    basicSalary[i] = salary;
                    break;
                } else {
                    System.out.println("Invalid! Salary cannot be negative.");
                }
            }

            // Bonus Validation
            while (true) {
                System.out.print("Bonus: ");
                double b = sc.nextDouble();

                if (b >= 0) {
                    bonus[i] = b;
                    break;
                } else {
                    System.out.println("Invalid! Bonus cannot be negative.");
                }
            }

            // Final Salary Calculation
            finalSalary[i] = basicSalary[i] + bonus[i];

            // Performance Rating
            if (finalSalary[i] >= 100000)
                ratings[i] = 'A';
            else if (finalSalary[i] >= 70000)
                ratings[i] = 'B';
            else if (finalSalary[i] >= 50000)
                ratings[i] = 'C';
            else
                ratings[i] = 'D';
        }

        // Find Highest Paid Employee
        int highestIndex = 0;

        for (int i = 1; i < employees; i++) {
            if (finalSalary[i] > finalSalary[highestIndex]) {
                highestIndex = i;
            }
        }

        // Final Report
        System.out.println("\n===== EMPLOYEE REPORT =====");

        System.out.println("ID\tName\tBasic\tBonus\tFinal Salary\tRating");

        for (int i = 0; i < employees; i++) {

            System.out.println(
                    (i + 1) + "\t"
                    + employeeNames[i] + "\t"
                    + basicSalary[i] + "\t"
                    + bonus[i] + "\t"
                    + finalSalary[i] + "\t\t"
                    + ratings[i]
            );
        }

        // Display Highest Paid Employee
        System.out.println("\n===== TOP EMPLOYEE =====");

        System.out.println("Employee Name: " + employeeNames[highestIndex]);
        System.out.println("Final Salary: " + finalSalary[highestIndex]);
        System.out.println("Rating: " + ratings[highestIndex]);

        sc.close();
    }
}

2. Online Shopping System (Based on Same Logic)

import java.util.Scanner;

public class OnlineShoppingSystem {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Input number of products
        System.out.print("Enter number of products: ");
        int products = sc.nextInt();

        String[] productNames = new String[products];
        double[] prices = new double[products];
        int[] quantities = new int[products];
        double[] totalAmount = new double[products];
        char[] categories = new char[products];

        // Input product details
        for (int i = 0; i < products; i++) {

            sc.nextLine(); // clear buffer

            System.out.println("\nEnter details for Product " + (i + 1));

            System.out.print("Product Name: ");
            productNames[i] = sc.nextLine();

            // Price Validation
            while (true) {
                System.out.print("Price: ");
                double price = sc.nextDouble();

                if (price > 0) {
                    prices[i] = price;
                    break;
                } else {
                    System.out.println("Invalid! Price must be greater than 0.");
                }
            }

            // Quantity Validation
            while (true) {
                System.out.print("Quantity: ");
                int qty = sc.nextInt();

                if (qty > 0) {
                    quantities[i] = qty;
                    break;
                } else {
                    System.out.println("Invalid! Quantity must be greater than 0.");
                }
            }

            // Total Amount Calculation
            totalAmount[i] = prices[i] * quantities[i];

            // Product Category
            if (totalAmount[i] >= 5000)
                categories[i] = 'A';
            else if (totalAmount[i] >= 3000)
                categories[i] = 'B';
            else if (totalAmount[i] >= 1000)
                categories[i] = 'C';
            else
                categories[i] = 'D';
        }

        // Find Highest Purchase
        int highestIndex = 0;

        for (int i = 1; i < products; i++) {
            if (totalAmount[i] > totalAmount[highestIndex]) {
                highestIndex = i;
            }
        }

        // Final Report
        System.out.println("\n===== SHOPPING REPORT =====");

        System.out.println("ID\tProduct\tPrice\tQty\tTotal\tCategory");

        for (int i = 0; i < products; i++) {

            System.out.println(
                    (i + 1) + "\t"
                    + productNames[i] + "\t"
                    + prices[i] + "\t"
                    + quantities[i] + "\t"
                    + totalAmount[i] + "\t"
                    + categories[i]
            );
        }

        // Display Highest Purchase
        System.out.println("\n===== HIGHEST PURCHASE =====");

        System.out.println("Product Name: " + productNames[highestIndex]);
        System.out.println("Total Amount: " + totalAmount[highestIndex]);
        System.out.println("Category: " + categories[highestIndex]);

        sc.close();
    }
}

3.Create a file and just write some content into the file with the help of a buffer writer.

import java.io.BufferedWriter;
import java.io.FileWriter;
import java.io.IOException;

public class WriteFileExample {

    public static void main(String[] args) {

        try {

            // Create file and write content
            BufferedWriter bw = new BufferedWriter(
                    new FileWriter("sample.txt")
            );

            bw.write("Hello World");
            bw.newLine();
            bw.write("This is a BufferedWriter example.");
            bw.newLine();
            bw.write("File created successfully.");

            // Close writer
            bw.close();

            System.out.println("Data written to file successfully.");

        } catch (IOException e) {

            System.out.println("Error: " + e.getMessage());
        }
    }
}

4.Read and display the file contents

1. Using FileReader
import java.io.FileReader;
import java.io.IOException;

public class ReadUsingFileReader {

    public static void main(String[] args) {

        try {

            FileReader fr = new FileReader("sample.txt");

            int ch;

            while ((ch = fr.read()) != -1) {
                System.out.print((char) ch);
            }

            fr.close();

        } catch (IOException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}

2. Using BufferedReader
import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;

public class ReadUsingBufferedReader {

    public static void main(String[] args) {

        try {

            BufferedReader br = new BufferedReader(
                    new FileReader("sample.txt")
            );

            String line;

            while ((line = br.readLine()) != null) {
                System.out.println(line);
            }

            br.close();

        } catch (IOException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}

