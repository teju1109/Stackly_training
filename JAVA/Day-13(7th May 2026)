2.simple interest with time period 

import java.util.Scanner;
class Interest 
{
    void calculateInterest(double p, double r, double t) 
    {
        double si = (p * r * t) / 100;
        System.out.println("Simple Interest : " + si);
    }
}

class TimePeriod extends Interest 
{
    @Override
    void calculateInterest(double p, double r, double t) 
    {
        double si = (p * r * t) / 100;
        System.out.println("Principal Amount : " + p);
        System.out.println("Rate of Interest : " + r);
        System.out.println("Time Period : " + t + " years");
        System.out.println("Simple Interest : " + si);
    }
}

public class Main 
{
    public static void main(String[] args) 
    {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter Principal Amount : ");
        double principal = sc.nextDouble();
        System.out.print("Enter Rate of Interest : ");
        double rate = sc.nextDouble();
        System.out.print("Enter Time Period : ");
        double time = sc.nextDouble();

        Interest obj = new TimePeriod();
        obj.calculateInterest(principal, rate, time);
    }
}

