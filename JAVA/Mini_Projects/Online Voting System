import java.util.*;

// Candidate Class
class Candidate
{
    String name;
    int votes;

    // Constructor
    Candidate(String name)
    {
        this.name = name;
        this.votes = 0;
    }
}

// Main Voting System Class
class OnlineVotingSystem
{
    // Store Employee ID and Voting Status
    HashMap<String, Boolean> employees = new HashMap<>();

    // Store Candidates
    ArrayList<Candidate> candidates = new ArrayList<>();

    Scanner sc = new Scanner(System.in);

    // Constructor
    OnlineVotingSystem()
    {
        // Add Candidates
        candidates.add(new Candidate("Rahul"));
        candidates.add(new Candidate("Priya"));
        candidates.add(new Candidate("Arjun"));
    }

    // Validate Employee ID
    boolean isValidEmployeeId(String employeeId)
    {
        return employeeId.matches("STK-\\d{2}-\\d{4}");
    }

    // Login Method
    String login()
    {
        System.out.println("\n===== EMPLOYEE LOGIN =====");

        System.out.print("Enter Stackly Employee ID: ");
        String employeeId = sc.next();

        // Validate Format
        if (!isValidEmployeeId(employeeId))
        {
            System.out.println("Invalid Employee ID Format!");
            System.out.println("Example Format: STK-26-2144");

            return null;
        }

        System.out.println("Login Successful!");

        return employeeId;
    }

    // Show Candidate List
    void showCandidates()
    {
        System.out.println("\n===== CANDIDATE LIST =====");

        for (int i = 0; i < candidates.size(); i++)
        {
            System.out.println((i + 1) + ". " + candidates.get(i).name);
        }
    }

    // Cast Vote
    void castVote(String employeeId)
    {
        // Check Already Voted
        if (employees.containsKey(employeeId))
        {
            System.out.println("You have already voted!");
            return;
        }

        showCandidates();

        System.out.print("Choose Candidate Number: ");

        try
        {
            int choice = sc.nextInt();

            // Validate Choice
            if (choice < 1 || choice > candidates.size())
            {
                System.out.println("Invalid Candidate Number!");
                return;
            }

            // Increase Vote Count
            candidates.get(choice - 1).votes++;

            // Mark Employee as Voted
            employees.put(employeeId, true);

            System.out.println("Vote Cast Successfully!");

        }
        catch (Exception e)
        {
            System.out.println("Invalid Input!");
            sc.nextLine();
        }
    }

    // Display Poll Results
    void showResults()
    {
        System.out.println("\n===== POLL RESULTS =====");

        Candidate winner = candidates.get(0);

        for (Candidate c : candidates)
        {
            System.out.println(c.name + " : " + c.votes + " Votes");

            // Find Winner
            if (c.votes > winner.votes)
            {
                winner = c;
            }
        }

        System.out.println("\nWinner is: " + winner.name);
    }

    // Main Menu
    void menu()
    {
        while (true)
        {
            System.out.println("\n===== ONLINE VOTING SYSTEM =====");

            System.out.println("1. Login & Vote");
            System.out.println("2. Display Poll Results");
            System.out.println("3. Exit");

            System.out.print("Enter Choice: ");

            try
            {
                int choice = sc.nextInt();

                switch (choice)
                {
                    case 1:

                        String employeeId = login();

                        if (employeeId != null)
                        {
                            castVote(employeeId);
                        }

                        break;

                    case 2:

                        showResults();
                        break;

                    case 3:

                        System.out.println("Thank You!");
                        System.exit(0);

                    default:

                        System.out.println("Invalid Choice!");
                }
            }
            catch (Exception e)
            {
                System.out.println("Please Enter Valid Number!");
                sc.nextLine();
            }
        }
    }
}

// Main Class
public class Main
{
    public static void main(String[] args)
    {
        OnlineVotingSystem obj = new OnlineVotingSystem();

        obj.menu();
    }
}

Very Important : Employee _id should be in STK-year-roll.no format (ex : STK-26-2144)
