in main class - get customer name and details

import java.util.Scanner;

// Interface
interface CabService 
{
    void bookRide();
    void calculateFare();
}

// Base Class
class Customer 
{
    String customerName;
    double distance;

    // Constructor
    Customer(String customerName, double distance) 
    {
        this.customerName = customerName;
        this.distance = distance;
    }
}

// Child Class 1
class MiniCab extends Customer implements CabService 
{
    MiniCab(String customerName, double distance) 
    {
        super(customerName, distance);
    }

    public void bookRide() 
    {
        System.out.println("Mini Cab Booked");
    }
    public void calculateFare() 
    {
        double fare = distance * 10;
        System.out.println("Fare for Mini Cab : " + fare);
    }
}

// Child Class 2
class SedanCab extends Customer implements CabService 
{
    SedanCab(String customerName, double distance) 
    {
        super(customerName, distance);
    }
    public void bookRide() 
    {
        System.out.println("Sedan Cab Booked");
    }
    public void calculateFare() 
    {
        double fare = distance * 15;
        System.out.println("Fare for Sedan Cab : " + fare);
    }
}

// Child Class 3
class LuxuryCab extends Customer implements CabService 
{
    LuxuryCab(String customerName, double distance) 
    {
        super(customerName, distance);
    }
    public void bookRide() 
    {
        System.out.println("Luxury Cab Booked");
    }
    public void calculateFare() 
    {
        double fare = distance * 25;
        System.out.println("Fare for Luxury Cab : " + fare);
    }
}

// Main Class
public class Main 
{
    public static void main(String[] args) 
    {
        Scanner sc = new Scanner(System.in);
        // Get Customer Details
        System.out.print("Enter Customer Name : ");
        String name = sc.nextLine();
        System.out.print("Enter Distance : ");
        double distance = sc.nextDouble();
        // Mini Cab
        MiniCab m = new MiniCab(name, distance);
        System.out.println("\n--- MINI CAB ---");
        System.out.println("Customer Name : " + m.customerName);

        m.bookRide();
        m.calculateFare();

        // Sedan Cab
        SedanCab s = new SedanCab(name, distance);
        System.out.println("\n--- SEDAN CAB ---");
        System.out.println("Customer Name : " + s.customerName);

        s.bookRide();
        s.calculateFare();

        // Luxury Cab
        LuxuryCab l = new LuxuryCab(name, distance);
        System.out.println("\n--- LUXURY CAB ---");
        System.out.println("Customer Name : " + l.customerName);

        l.bookRide();
        l.calculateFare();
    }
}

here :
--> interface is CabService
--> Methods used bookRide() and calculateFare()
--> class used is Customer that Contains customerName and distance which is Initialized using constructor.
--> Child Classes are MiniCab, SedanCab and LuxuryCab where Each class Extends CustomerImplements and CabService.
| Keyword    | Meaning                  |
| ---------- | ------------------------ |
| interface  | Creates rules            |
| implements | Uses interface           |
| extends    | Inherits base class      |
| super()    | Calls parent constructor |


